{
  "name": "cracha",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cracha/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["node-env=production"]
      },
      "configurations": {
        "development": {
          "args": ["node-env=development"]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "cracha:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "cracha:build:development"
        },
        "production": {
          "buildTarget": "cracha:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true,
        "coverage": true
      }
    },
    "setup-local-env": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "/bin/bash ./scripts/setup-envs.sh DEV"
          }
        ]
      }
    },
    "run-test-scripts": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "/bin/bash ./scripts/setup-tests.sh"
          }
        ]
      }
    }
  }
}
